class Solution:
    def rotateMatrix(self, mat):
        n=len(mat)
        
        result=[]
        for i in range(n):
            for j in range(i+1,n):
                mat[i][j],mat[j][i]=mat[j][i],mat[i][j]
        for i in range(n//2):
            mat[i],mat[n-1-i]=mat[n-1-i],mat[i]
        return i    
       
                
