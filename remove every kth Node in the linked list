class Node:
    def __init__(self, x):
        self.data = x
        self.next = None


class Solution:
    def deleteK(self, head, k):

        if head is None:
            return head

        temp = head
        prev = None

        for i in range(1, k):
            if temp is None:
                break

            prev = temp
            temp = temp.next

        
        if temp is None:
            return head

       
        if prev is None:
            head = temp.next
        else:
            prev.next = temp.next

       
        nextNode = temp.next

       
        if prev is None:
            return self.deleteK(nextNode, k)

        prev.next = self.deleteK(nextNode, k)

        return head
