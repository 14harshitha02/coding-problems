''' Structure of Linked List Node
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None
'''

class Solution:
    def deleteNode(self, head, x):
        
        if head is None:
            return head
        if(x==1):
            return head.next
        temp=head
        for i in range(1,x-1):
            temp=temp.next
        temp.next=temp.next.next
        return head
            
            
