''' Structure of linked list Node
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None
'''
class Solution:
    def getCount(self, head):
        # code here
        count=1
        if head is None:
            return count
        while head.next is not None:
            head=head.next
            count+=1
        return count    
