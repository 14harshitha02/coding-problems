'''    
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None
'''

class Solution:
    def insertAtEnd(self, head, x):
        
       
        newNode = Node(x)

        
        if head is None:
            return newNode

       
        last = head

        while last.next is not None:
            last = last.next

       
        last.next = newNode

       
        return head
            
