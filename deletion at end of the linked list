'''
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None
'''
class Solution:
    def removeLastNode(self, head):
        # code here
        if head is None:
            return head
        if head.next is None:
            return None
        secondlast=head
        while secondlast.next.next is not None:
            
            secondlast=secondlast.next
        secondlast.next=None
        return head
        
