''' Structure of doubly linked list node
class Node:
    def __init__(self, x):
        self.data = x
        self.next = None
        self.prev = None
'''
class Solution:
    def insertInTail(self, head, data):
        newNode = Node(data)
        if head is None:
            return newNode
        temp = head
        while temp.next is not None:
            temp = temp.next
        temp.next = newNode
        newNode.prev = temp
        return head
