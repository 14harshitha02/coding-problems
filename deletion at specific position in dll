""" Structure of a Doubly Linked List Node
class Node:
    def __init__(self, d):
        self.data = d
        self.prev = None
        self.next = None
"""

class Solution:
    def delPos(self, head, x):
        if head is None:
            return head
        temp = head
        for i in range(x - 1):
            temp = temp.next
        if temp.prev:
            temp.prev.next = temp.next
        else:
            head = temp.next
        if temp.next:
            temp.next.prev = temp.prev
        return head
