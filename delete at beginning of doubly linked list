''' Structure of doubly linked list Node
 class Node:
    def __init__(self, x):
        self.data = x
        self.next = None
        self.prev = None
'''
class Solution:
    def deleteHead(self, head):
       
        if head is None:
            return None
        head=head.next
        if head is not None:
            head.prev=None
        return head    
